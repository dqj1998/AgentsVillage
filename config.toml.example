[core]
# Number of recent messages to keep in LLM context window (default: 20)
# Per-agent override: add [core] context_window = N to workspace/{agent_id}/config.toml
context_window = 20

[platform]
name = "AgentsVillage"

[llm]
provider = "openrouter"
base_url = "https://openrouter.ai/api/v1"
model = "tencent/hy3-preview"
timeout_secs = 60

[discord]
application_id = "YOUR_APPLICATION_ID"
guild_id = "YOUR_GUILD_ID"
channel_id = "YOUR_CHANNEL_ID"
channel_name = "unknown"
